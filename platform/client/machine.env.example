# Copy to config.local/machine.env and fill in real values.
# config.local/ is gitignored. See RUNBOOK.md for where each value comes from.

# IAM Identity Center: the AWS access portal URL and its Region
# (IAM Identity Center > Dashboard > Settings summary).
SSO_START_URL=https://YOUR_PORTAL.awsapps.com/start
SSO_REGION=us-east-1

# Your own admin sign-in: the account and permission set you administer from.
ADMIN_ACCOUNT_ID=111122223333
ADMIN_ROLE=Admin

# The agent user's sign-in: the agent account and its two permission sets.
AGENT_ACCOUNT_ID=111122223333
BUILDER_ROLE=Agent-Builder
READONLY_ROLE=Agent-ReadOnly

# Default Region for the AWS CLI profiles.
AWS_REGION=us-east-1

# Where the factory skills are cloned, and where from.
FACTORY_SKILLS_DIR=$HOME/Code/factory-skills
FACTORY_SKILLS_REPO=git@github.com:ErikBean/factory-skills.git

# Node.js major version to install. OpenSpec needs 22.12 or later; the factory's CDK apps target 24.
NODE_MAJOR=24
